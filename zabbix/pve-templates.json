   {
    "uuid": "e5f34d9b250d4eabba904de0a1265108",
    "template": "PVE cluster by Prometheus",
    "name": "PVE cluster by Prometheus",
    "description": "Discovers Proxmox VE nodes and running guests from Prometheus and creates a host for each.",
    "groups": [
     {
      "name": "Templates/Virtualization"
     }
    ],
    "items": [
     {
      "uuid": "04034d9465df43c1bd3dc02957bbd472",
      "name": "Prometheus federate: PVE inventory",
      "type": "HTTP_AGENT",
      "key": "pve.federate",
      "delay": "1m",
      "history": "0",
      "value_type": "TEXT",
      "trends": "0",
      "url": "{$PROM.URL}/federate",
      "query_fields": [
       {
        "name": "match[]",
        "value": "{job=\"proxmox-ve\",__name__=\"proxmox_node_uptime_seconds\"}"
       },
       {
        "name": "match[]",
        "value": "{job=\"homestack-pve-agent\",__name__=\"hs_pve_cpu_capacity\"}"
       }
      ],
      "description": "Lists running nodes and guests for discovery.",
      "tags": [
       {
        "tag": "component",
        "value": "raw"
       }
      ],
      "triggers": [
       {
        "uuid": "ef47b8afa9f24fae8079782dd1e19a86",
        "expression": "nodata(/PVE cluster by Prometheus/pve.federate,5m)=1",
        "name": "No data from Prometheus for 5 minutes",
        "priority": "AVERAGE",
        "description": ""
       }
      ]
     }
    ],
    "discovery_rules": [
     {
      "uuid": "453b75569f674d1fae3a239c82b429db",
