          "tag": "pve-node",
          "value": "{#NODE}"
         }
        ]
       }
      ],
      "lifetime_type": "DELETE_AFTER",
      "lifetime": "30d",
      "enabled_lifetime_type": "DISABLE_IMMEDIATELY"
     },
     {
