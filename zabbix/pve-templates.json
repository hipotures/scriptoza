     {
      "uuid": "20e8c8732bc94038a72b0328c419e189",
      "name": "File systems",
      "type": "DEPENDENT",
      "key": "pve.guest.fs.discovery",
      "delay": "0",
      "lifetime_type": "DELETE_IMMEDIATELY",
      "master_item": {
       "key": "pve.federate"
      },
      "filter": {
       "evaltype": "AND",
       "conditions": [
        {
         "macro": "{#FSTYPE}",
         "value": "{$PVE.FS.TYPE.NOT_MATCHES}",
         "operator": "NOT_MATCHES_REGEX",
         "formulaid": "A"
        },
        {
         "macro": "{#MOUNT}",
         "value": "{$PVE.FS.MOUNT.NOT_MATCHES}",
         "operator": "NOT_MATCHES_REGEX",
         "formulaid": "B"
        }
       ]
      },
      "preprocessing": [
