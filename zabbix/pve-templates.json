         {
          "type": "PROMETHEUS_PATTERN",
          "parameters": [
           "hs_pve_filesystem_total_bytes{mount=\"{#MOUNT}\"}",
           "value",
           ""
          ],
          "error_handler": "DISCARD_VALUE"
         }
        ],
        "master_item": {
         "key": "pve.federate"
        },
        "tags": [
         {
          "tag": "component",
          "value": "storage"
         }
        ]
       },
       {
        "uuid": "31d32e721e7344b98931d9f7206f8b7d",
        "name": "FS {#MOUNT}: used",
        "type": "DEPENDENT",
        "key": "pve.guest.fs.used[{#MOUNT}]",
        "delay": "0",
        "value_type": "UNSIGNED",
        "units": "B",
        "description": "",
        "preprocessing": [
         {
          "type": "PROMETHEUS_PATTERN",
          "parameters": [
           "hs_pve_filesystem_used_bytes{mount=\"{#MOUNT}\"}",
           "value",
           ""
          ],
          "error_handler": "DISCARD_VALUE"
         }
        ],
        "master_item": {
         "key": "pve.federate"
        },
        "tags": [
         {
          "tag": "component",
          "value": "storage"
         }
        ]
       },
       {
        "uuid": "6d4035fe34154e5c91fb0ff81231e2ce",
        "name": "FS {#MOUNT}: used, %",
        "type": "CALCULATED",
        "key": "pve.guest.fs.pused[{#MOUNT}]",
        "delay": "1m",
        "value_type": "FLOAT",
        "units": "%",
        "params": "100*last(//pve.guest.fs.used[{#MOUNT}])/last(//pve.guest.fs.total[{#MOUNT}])",
        "tags": [
         {
          "tag": "component",
          "value": "storage"
         }
        ],
        "trigger_prototypes": [
         {
          "uuid": "d0c68fc0054547dfbc621f084df5dc8e",
          "expression": "last(/PVE guest by Prometheus/pve.guest.fs.pused[{#MOUNT}])>{$PVE.FS.PUSED.WARN}",
          "name": "File system {#MOUNT} is over {$PVE.FS.PUSED.WARN}% full",
