{
  "manifest_version": 2,
  "name": "Firefox yt-dlp Downloader",
  "version": "1.0",
  "description": "Download the current tab's video with yt-dlp.",
  "browser_action": {
    "default_title": "Download video"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-yt-downloader@example.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
