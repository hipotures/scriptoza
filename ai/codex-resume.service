[Unit]
Description=Monitor Codex panes and resume capacity errors
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/codex-resume resume
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
